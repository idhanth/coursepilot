# Copy to backend/.env and fill in. backend/.env is git-ignored: never commit real values.
DATABASE_URL=postgresql+psycopg://127.0.0.1:5435/coursepilot
FRONTEND_URL=http://localhost:5173

# Secret key that signs login tokens (at least 32 characters). Generate your own with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# The placeholder below is deliberately too short, so the app refuses to start until it is replaced.
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
